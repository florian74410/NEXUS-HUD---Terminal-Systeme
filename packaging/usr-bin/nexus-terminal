#!/usr/bin/env bash
set -euo pipefail
APP=/opt/nexus-terminal
VENV="${XDG_DATA_HOME:-$HOME/.local/share}/nexus-terminal/venv"
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
fi
if ! "$VENV/bin/python" -c 'import PySide6,pyside6_qtermwidget' 2>/dev/null; then
  "$VENV/bin/python" -m pip install -r "$APP/requirements.txt"
fi
cd "$APP"
exec "$VENV/bin/python" "$APP/nexus_workspace.py" "$@"
